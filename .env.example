APP_ENV=development
APP_ADDR=:8080
DATABASE_URL=postgres://netassets:netassets@postgres:5432/netassets?sslmode=disable
STATIC_DIR=/app/web
SESSION_COOKIE_NAME=netassets_session
SESSION_TTL=12h

# First-start bootstrap data. Replace the password before starting.
BOOTSTRAP_GROUP_CODE=GROUP
BOOTSTRAP_GROUP_NAME=示例集团
BOOTSTRAP_GROUP_SHORT_NAME=集团总部
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=请替换为至少10位的强密码
BOOTSTRAP_ADMIN_DISPLAY_NAME=集团管理员
SESSION_COOKIE_SECURE=false

# Daily full-ledger data quality scan. Multiple app instances coordinate through PostgreSQL.
DATA_QUALITY_AUTO_SCAN_ENABLED=true
DATA_QUALITY_AUTO_SCAN_TIME=02:00
DATA_QUALITY_AUTO_SCAN_TIMEZONE=Asia/Shanghai

POSTGRES_DB=netassets
POSTGRES_USER=netassets
POSTGRES_PASSWORD=netassets

# Container build proxy (Podman VM reaches the host through host.containers.internal)
BUILD_HTTP_PROXY=http://host.containers.internal:6152
BUILD_HTTPS_PROXY=http://host.containers.internal:6152
BUILD_ALL_PROXY=socks5h://host.containers.internal:6153
BUILD_NO_PROXY=localhost,127.0.0.1,postgres,app
GOPROXY=https://proxy.golang.org,direct

# Playwright container dependency-install proxy
E2E_HTTP_PROXY=http://host.containers.internal:6152
E2E_HTTPS_PROXY=http://host.containers.internal:6152
E2E_NO_PROXY=localhost,127.0.0.1,app,postgres
